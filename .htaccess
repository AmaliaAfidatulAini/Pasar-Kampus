<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    # Prevent direct access to sensitive folders
    RewriteRule ^app/ - [F,L]

    # Serve public assets without exposing the public directory in the URL
    RewriteRule ^assets/(.*)$ public/assets/$1 [L]
    RewriteRule ^uploads/(.*)$ public/uploads/$1 [L]

    # If the request is NOT a real file or directory, send to index.php
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php?url=$1 [QSA,L]
</IfModule>
